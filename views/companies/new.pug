extends ../layout

block content
    .row.align-items-center
        .col-8
            h1= title
        
        .col-4.text-end
            a.btn(href="/companies") Back to #{helpers.plural(fields.system.company)}

        .col-12 
            form(action="/companies/create", method="post").row
                - const page = 'new' 
                include ./form

                .col-12
                    .form-group.mt-4 
                        button(type="submit") Create #{helpers.downcase(fields.system.company)}
