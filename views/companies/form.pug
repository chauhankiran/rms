.col-12
    h3 #{fields.system.company} details 

.col-6
    //-- Name
    if fields.companies.name
        .form-group 
            label(for="name")= fields.companies.name
            if page == 'show'
                p= company.name
            else
                input(type="text", name="name", placeholder="Kai", value=company ? company.name : '', autofocus=true)#name

