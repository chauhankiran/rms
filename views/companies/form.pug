    //-- City
    if fields.companies.city
        .form-group 
            label(for="city")= fields.companies.city
            if page == 'show'
                p= company.city || "-"
            else
                input(type="text", name="city", placeholder="Remote", value=company ? company.city : null)#city

    //-- Zip                
    if fields.companies.zip
        .form-group 
            label(for="zip")= fields.companies.zip
            if page == 'show'
                p= company.zip || "-"
            else
                input(type="text", name="zip", placeholder="123456", value=company ? company.zip : null)#zip

    //-- State (R)
    if fields.companies.stateId
        .form-group 
            label(for="stateId")= fields.companies.stateId
            if page == 'show'
                p= company.state || "-"
            else
                select(name="stateId")#stateId
                    option(value="") None
                    each state in states
                        if company && company.stateId == state.id
                            option(value=state.id, selected)= state.name
                        else
                            option(value=state.id)= state.name

    //-- Country (R)
    if fields.companies.countryId
