extends ../layout

block content
    .row
        .col-8
            h1= title
        
        .col-4.text-end
            a.btn(href="/companies") Back to #{helpers.plural(fields.system.company)}
        
        .col-12 
            .row
                - const page = 'show' 
                include ./form

            .row 
                .col-12
                    a.btn.mt-4(href=`/companies/${company.id}/edit`) Edit #{helpers.downcase(fields.system.company)}